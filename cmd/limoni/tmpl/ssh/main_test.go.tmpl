package main

import (
	"testing"

	"github.com/thebanri/limoni/uitest"
)

// The session's application is tested without SSH: uitest runs its draw
// function in process and reads it through the semantic tree.
func TestSessionGreetsTheUser(t *testing.T) {
	page := uitest.Run(t, 70, 12, newSession("ada").draw)
	page.Expect(page.GetByID("greeting")).ToContainValue("Hello, ada.")
	page.Press("x")
	page.Expect(page.GetByID("greeting")).ToContainValue("Keys pressed: 1")
	page.Press("q")
	page.ExpectExit()
}
